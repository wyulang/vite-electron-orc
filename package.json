{
  "name": "xiaoxuebao",
  "private": true,
  "version": "0.0.0",
  "main": "www/index.js",
  "build": {
    "appId": "demo.wyulang.app",
    "copyright": "Copyright © 2024 <demo>",
    "productName": "demo",
    "asar": false,
    "npmRebuild": false,
    "win": {
      "icon": "./logo.ico",
      "artifactName": "${productName}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "cdn/",
        "to": "cdn/"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "win": "vite build && electron-builder",
    "preview": "vite preview",
    "rd": "electron-rebuild -f -w duckdb"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "csv-parser": "^3.2.0",
    "duckdb": "^1.2.1",
    "easy-formula-editor": "^0.0.2-alpha.1",
    "electron-log": "^5.0.1",
    "mysql2": "^3.14.0",
    "paddleocrjson": "^1.1.1-a",
    "pinia": "^2.1.7",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.2.5",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-vue": "^4.5.0",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.11",
    "less": "^4.2.0",
    "tree-kill": "^1.2.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.15.4",
    "vue-tsc": "^1.8.22"
  }
}
